{
  "description": "Point the model at solve_captcha when a browser tool hits a captcha, and block hand-clicking captcha widgets",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^mcp__.*(playwright|chrome|browser)",
        "hooks": [
          { "type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/detect_captcha.py"], "timeout": 10 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^mcp__.*(playwright|chrome|browser)",
        "hooks": [
          { "type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/guard_captcha_click.py"], "timeout": 10 }
        ]
      }
    ]
  }
}
